{
  "name": "bruce-autobook",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-book weekly Bruce Studios classes the moment their booking window opens (Node service, Cloudflare Worker or macOS launchd).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "autobook": "src/node/cli.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/node/cli.ts run",
    "tick": "node --env-file-if-exists=.env src/node/cli.ts tick",
    "plan": "node --env-file-if-exists=.env src/node/cli.ts plan",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
