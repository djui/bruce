# Copy to Bruce-iOS/.env (git-ignored) for scripts/testflight.sh. Variables already set in the
# environment take precedence over this file.

# Apple Developer team ID. If empty, DEVELOPMENT_TEAM from Config/Local.xcconfig is used.
TEAM_ID=
# App Store Connect API key (App Store Connect > Users and Access > Integrations > Keys).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional: path to the .p8 key. Default: ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=
# Optional: bundle ID to upload (default net.dauernheim.bruce; use your own App Store Connect app).
# BUNDLE_ID=
