// Bruce-iOS build settings. Personal values (your Apple team) go in Config/Local.xcconfig, which is
// git-ignored. Copy Config/Local.xcconfig.example to get started, e.g.
//   DEVELOPMENT_TEAM = ABCDE12345
//   APP_DISPLAY_NAME = Something Else

// Home-screen name (CFBundleDisplayName). Unofficial client: never "Bruce Studios".
APP_DISPLAY_NAME = Brüce

// The app's bundle id; the widget extension is $(BRUCE_BUNDLE_ID).widgets. scripts/testflight.sh overrides
// BRUCE_BUNDLE_ID (not PRODUCT_BUNDLE_IDENTIFIER, which would hit both targets).
BRUCE_BUNDLE_ID = net.dauernheim.bruce
PRODUCT_BUNDLE_IDENTIFIER = $(BRUCE_BUNDLE_ID)
// Set DEVELOPMENT_TEAM in Config/Local.xcconfig (simulator builds need none).
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 1.7.0
CURRENT_PROJECT_VERSION = 7

IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Push notifications from the auto-book server (server/README.md); the widget extension has its own file. Both carry the
// App Group for the widget snapshot. scripts/testflight.sh overrides these two per target (APP_GROUP=0 archives without
// the group while it is not registered on the App IDs yet).
BRUCE_APP_ENTITLEMENTS = Config/BruceiOS.entitlements
BRUCE_WIDGET_ENTITLEMENTS = Config/BruceWidgets.entitlements
CODE_SIGN_ENTITLEMENTS = $(BRUCE_APP_ENTITLEMENTS)

#include? "Local.xcconfig"
